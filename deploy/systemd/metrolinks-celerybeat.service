[Unit]
Description=Metrolinks Celery beat — shared VPS with Soma Smart
After=network.target redis-server.service metrolinks-celery.service
Requires=redis-server.service

[Service]
Type=simple
User=metrolinks
Group=www-data
WorkingDirectory=/srv/metrolinks
EnvironmentFile=/srv/metrolinks/.env
ExecStart=/srv/metrolinks/.venv/bin/celery \
    -A ticket beat \
    --loglevel=INFO \
    --schedule=/srv/metrolinks/tmp/celerybeat-schedule
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
