[Unit]
Description=Metrolinks Celery worker — shared VPS with Soma Smart
After=network.target redis-server.service metrolinks-gunicorn.service
Requires=redis-server.service

[Service]
Type=simple
User=metrolinks
Group=www-data
WorkingDirectory=/srv/metrolinks
EnvironmentFile=/srv/metrolinks/.env
ExecStart=/srv/metrolinks/.venv/bin/celery \
    -A ticket worker \
    --loglevel=INFO \
    --concurrency=1
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
