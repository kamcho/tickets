[Unit]
Description=Metrolinks Celery worker
After=network.target redis-server.service metrolinks-gunicorn.service
Requires=redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/metrolinks
EnvironmentFile=/var/www/metrolinks/.env
ExecStart=/var/www/metrolinks/.venv/bin/celery \
    -A ticket worker \
    --loglevel=INFO \
    --concurrency=2
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
