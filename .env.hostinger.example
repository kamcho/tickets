# =============================================================================
# Shared VPS with Soma Smart (Elearning at /srv/elearning)
# Copy on the server:  cp .env.hostinger.example .env && nano .env
# App path: /srv/metrolinks
# =============================================================================

SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-hex-32

DEBUG=False
TIME_ZONE=Africa/Nairobi
LOG_LEVEL=INFO

ALLOWED_HOSTS=metrolinkssolutionltd.co.ke,www.metrolinkssolutionltd.co.ke,tickets.metrolinkssolutionltd.co.ke,127.0.0.1,localhost

CSRF_TRUSTED_ORIGINS=https://metrolinkssolutionltd.co.ke,https://www.metrolinkssolutionltd.co.ke,https://tickets.metrolinkssolutionltd.co.ke

SITE_BASE_URL=https://tickets.metrolinkssolutionltd.co.ke
TICKETS_PORTAL_LOGIN_URL=https://tickets.metrolinkssolutionltd.co.ke/portal/login/
PARENT_HOST=metrolinkssolutionltd.co.ke

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# --- Postgres (same server as Soma Smart; SEPARATE database/user) ---
DB_ENGINE=postgres
DB_NAME=metrolinks
DB_USER=metrolinks
DB_PASSWORD=CHANGE-ME-strong-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Celery + Redis (use DB index 1 so we don't clash with other apps on DB 0) ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# Modest workers — VPS is shared with Soma Smart
GUNICORN_WORKERS=2
GUNICORN_BIND=unix:/run/metrolinks/metrolinks.sock

# --- UjumbeSMS ---
UJUMBE_SMS_API_KEY=
UJUMBE_SMS_EMAIL=
SMS_DEBUG_PRINT=False

# --- Safaricom Daraja M-Pesa ---
# MPESA_ENVIRONMENT=production
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=

# --- MikroTik (prefer Admin → Network routers) ---
# MIKROTIK_ENABLED=False

COMPANY_PHONE_PRIMARY=0792929275
COMPANY_PHONE_SECONDARY=0746464696
COMPANY_EMAIL=metrolinkssolutionltd@gmail.com
