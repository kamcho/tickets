# =============================================================================
# Hostinger VPS — copy to .env on the server and fill in secrets
#   cp .env.hostinger.example .env && nano .env
# =============================================================================

SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-hex-32

DEBUG=False
TIME_ZONE=Africa/Nairobi
LOG_LEVEL=INFO

# Domains (apex + www marketing, tickets portal)
ALLOWED_HOSTS=metrolinkssolutionltd.co.ke,www.metrolinkssolutionltd.co.ke,tickets.metrolinkssolutionltd.co.ke,127.0.0.1,localhost

CSRF_TRUSTED_ORIGINS=https://metrolinkssolutionltd.co.ke,https://www.metrolinkssolutionltd.co.ke,https://tickets.metrolinkssolutionltd.co.ke

SITE_BASE_URL=https://tickets.metrolinkssolutionltd.co.ke
TICKETS_PORTAL_LOGIN_URL=https://tickets.metrolinkssolutionltd.co.ke/portal/login/
# Parent domain for django-hosts reverse (www / tickets subdomains)
PARENT_HOST=metrolinkssolutionltd.co.ke

# Behind nginx TLS termination (defaults are on when DEBUG=False)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# --- MySQL / MariaDB (Hostinger VPS local or managed) ---
DB_ENGINE=mysql
DB_NAME=metrolinks
DB_USER=metrolinks
DB_PASSWORD=CHANGE-ME-strong-db-password
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Celery + Redis (required for scheduled disconnect / billing jobs) ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# --- UjumbeSMS ---
UJUMBE_SMS_API_KEY=
UJUMBE_SMS_EMAIL=
# UJUMBE_SMS_SENDER_ID=Metrolinks
# UJUMBE_SMS_ENABLED=True
SMS_DEBUG_PRINT=False

# --- Safaricom Daraja M-Pesa ---
# MPESA_ENVIRONMENT=production
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_PARTY_B=
# MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Callback defaults to SITE_BASE_URL/api/mpesa/stk/callback/
# MPESA_CALLBACK_URL=https://tickets.metrolinkssolutionltd.co.ke/api/mpesa/stk/callback/
# MPESA_INITIATOR_NAME=
# MPESA_SECURITY_CREDENTIAL=
# MPESA_IDENTIFIER_TYPE=4

